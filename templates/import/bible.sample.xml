  </BIBLEBOOK>
  <BIBLEBOOK bnumber="43" bname="Giăng">
    <CHAPTER cnumber="1">
      <VERS vnumber="1">Đây là câu mẫu số một của sách thứ bốn mươi ba.</VERS>
      <VERS vnumber="2">Đây là câu mẫu số hai của sách thứ bốn mươi ba.</VERS>
