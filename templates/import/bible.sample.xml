<XMLBIBLE biblename="Bản dịch mẫu" type="x-bible" status="v" version="2.0.1.18">
  <INFORMATION>
    <title>Bản dịch mẫu</title>
    <language>vie</language>
  </INFORMATION>
  <!-- bnumber = số thứ tự sách (1 = Sáng thế ký ... 66 = Khải huyền). bname là tùy chọn. -->
  <BIBLEBOOK bnumber="1" bname="Sáng-thế Ký">
    <CHAPTER cnumber="1">
      <VERS vnumber="1">Đây là câu mẫu số một của chương một.</VERS>
