{
  "name": "easyworship-app",
  "version": "3.1.11",
  "description": "Presentation For Church - Worship Presentation App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -c tailwind.config.js -i src/css/tailwind.input.css -o src/css/tailwind.generated.css --minify",
    "build": "npm run build:all",
    "build:win": "npm run build:css && node scripts/kill-running.js && electron-builder --win",
    "build:mac": "npm run build:css && electron-builder --mac",
    "build:all": "npm run build:css && electron-builder --win --mac",
    "build:store": "npm run build:css && electron-builder --win appx --config electron-builder.store.js"
  },
  "build": {
    "appId": "com.church.presentation",
    "productName": "Presentation For Church",
    "artifactName": "Presentation.For.Church.Setup.${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "live.html",
      "src/**/*",
      "comm/**/*",
      "fonts/**/*",
      "templates/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "bcsch",
        "name": "Worship Schedule",
        "description": "Presentation For Church schedule",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Presentation For Church",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Presentation.For.Church.Portable.${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "mammoth": "^1.12.0"
  }
}
